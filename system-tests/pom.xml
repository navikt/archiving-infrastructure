<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
				 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>no.nav.soknad.arkivering</groupId>
	<artifactId>archiving-system-tests</artifactId>
	<version>1.1.0</version>
	<packaging>pom</packaging>
	<name>${project.artifactId}</name>
	<description>End-to-end-tests</description>

	<modules>
		<module>clients</module>
		<module>system-tests</module>
	</modules>

	<properties>
		<java.version>21</java.version>
		<kotlin.version>2.2.0</kotlin.version>
		<maven.version>3.8.8</maven.version>
		<maven-dependency-plugin.version>3.11.0</maven-dependency-plugin.version>
		<maven-surefire-plugin.version>3.5.6</maven-surefire-plugin.version>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

		<springframework.version>7.0.9</springframework.version>
		<!--Kotlin -->
		<kotlin.compiler.jvmTarget>${java.version}</kotlin.compiler.jvmTarget>
		<coroutines.version>1.11.0</coroutines.version>

		<!-- Kafka -->
		<kafka.version>3.9.2</kafka.version>
		<arkivering-schemas.version>1.4.4-bf301c4492e2</arkivering-schemas.version>

		<!-- Logging -->
		<logstash.version>7.4</logstash.version>

		<!-- Test -->
		<testcontainers.version>2.0.5</testcontainers.version>
		<testcontainers-postgresql.version>2.0.5</testcontainers-postgresql.version>
		<testcontainers-kafka.version>2.0.5</testcontainers-kafka.version>
		<mockk.version>1.14.5</mockk.version>
		<springmockk.version>4.0.2</springmockk.version>
		<wiremock.version>3.13.2</wiremock.version>
		<okhttp3.version>4.11.0</okhttp3.version>
		<token-support.version>5.0.34</token-support.version>
		<logback.version>1.6.3</logback.version>
		<slf4j.version>2.0.18</slf4j.version>
		<postgresql.version>42.7.13</postgresql.version>
		<jackson.version>2.22.2</jackson.version>
		<junit-jupiter.version>5.11.0</junit-jupiter.version>
		<xml-apis.version>1.4.01</xml-apis.version>
<!--
		<xml-apis-ext.version>1.3.04</xml-apis-ext.version>
-->
		<batik-dom.version>1.19</batik-dom.version>
		<batik-svg-dom.version>1.19</batik-svg-dom.version>


		<!-- Plugins -->
		<openapi-generator-maven-plugin.version>7.0.0</openapi-generator-maven-plugin.version>

		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

	</properties>


	<repositories>
		<repository>
			<id>github</id>
			<url>https://github-package-registry-mirror.gc.nav.no/cached/maven-release</url>
		</repository>
		<repository>
			<id>central</id>
			<url>https://repo1.maven.org/maven2</url>
		</repository>
	</repositories>
</project>
